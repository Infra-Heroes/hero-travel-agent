# Copy to .env for `make run`; .env is ignored by git. Every value is optional:
# without OPENROUTER_API_KEY the agent runs in demo mode with sample answers.
# All variables: docs/configuration.md

# Model (secret). Without it: demo mode.
OPENROUTER_API_KEY=
# AGENT_MODEL=deepseek/deepseek-v4-flash

# Sign-in codes: either a mail server ...
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Urlaubs-Agent <noreply@localhost>
# ... or the codes in the log (development only)
MAIL_BACKEND=console

# Signs the session cookies (secret, 16+ characters). Generated into DATA_DIR if empty.
# SESSION_SECRET=

DATA_DIR=./data
LOG_LEVEL=info
# USER_DAILY_QUERIES=10
# AGENT_DAILY_CALLS=200
# METRICS_TOKEN=
